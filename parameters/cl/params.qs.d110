###########################################################################
#     Parameter file for Cado-NFS
###########################################################################
# See parameters/factor/params.c90 for an example which contains some
# documentation.
# See parameters/cl/params.qs.d90 for an example which contains some
# documentation specific to the QS algorithm for class groups computation.
#
# Parameters chosen (November 2026) to minimise sieving + linear algebra
# together: unlike for factoring, the linear algebra cost grows like the
# cube of the matrix size (the determinants have about 1.9 bits per row, so
# the number of moduli grows with the matrix).
# Sieving statistics measured; filtering simulated; not run.
#
# Expected for a typical discriminant, in core time of a 2.1 GHz Xeon
# (Emerald Rapids): about 11 core-days (sieving 8 core-days,
# linear algebra 55 core-hours), 3.9e+05 special-q's, a matrix with about
# 23500 rows, 1.2 GB per sieving process.
# The sieving time depends on which small primes split: 30 % more or less
# is common between discriminants of the same size.
#

###########################################################################
# General parameters
###########################################################################

name = d110

###########################################################################
# Sieve
###########################################################################

tasks.I = 13
tasks.lim0 = 1600000
tasks.lpb0 = 28
tasks.sieve.mfb0 = 56

# The special-q's are products of qfac_nfac primes taken in increasing order
# from qfac_min on.  The range below suits |D| around 10^109.5; for a given
# discriminant the best yield is obtained when the primes actually used are
# centred on (sqrt(|D|)/2^(I-1))^(1/qfac_nfac).
tasks.sieve.qfac_nfac = 16
tasks.sieve.qfac_min = 1386
tasks.sieve.qfac_max = 2306

tasks.sieve.qrange = 200

tasks.sieve.ncurves0 = 20

tasks.sieve.rels_wanted = 2920000

###########################################################################
# Filtering
###########################################################################

tasks.filter.target_density = 170.0
tasks.nmatrices = 2

###########################################################################
# Linalg
###########################################################################

# The determinants are large (about 1.9 bits per row of the matrix), so many
# moduli are needed; wide moduli are cheaper per bit of determinant.  Do not
# go above 704: the prime is part of the workunit file names, and those
# become too long for most filesystems.
tasks.linalg.moduli_nbits = 704
